# Strapi backend (Next.js proxies /strapi-api → this URL in local dev to avoid CORS)
NEXT_PUBLIC_STRAPI_URL=https://dashboard.plantozone.com
NEXT_PUBLIC_API_URL=https://dashboard.plantozone.com
# Local Strapi: NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# Strapi API token (Settings → API Tokens → Full access) — required for admin CRUD & promo validation
STRAPI_API_TOKEN=
NEXT_PUBLIC_STRAPI_API_TOKEN=

# Shiprocket (server-only — used by /api/track-order)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Site URL (for track-order links in emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order confirmation email (optional — FormSubmit used if not set)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
ORDER_EMAIL_FROM=Plantozone <noreply@plantozone.com>
ORDER_EMAIL_ADMIN=plantozonegreenindia@gmail.com
